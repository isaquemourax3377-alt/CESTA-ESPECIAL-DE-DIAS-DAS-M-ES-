<!DOCTYPE html><html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DIA DAS MÃES</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gradient-to-b from-pink-100 to-white font-sans">  <!-- Header -->  <header class="bg-red-500 text-white p-5 text-center text-3xl font-bold shadow-lg">
    🌸 DIA DAS MÃES 🌸
  </header>  <!-- Produto -->  <section class="p-6 flex flex-col items-center">
    <div class="bg-white p-4 rounded-2xl shadow-xl max-w-md">
      <img src="/mnt/data/file_0000000054ec71f5a2b59636f53161e6" class="rounded-xl">
      <h2 class="text-2xl font-bold mt-4">Cesta Café da Manhã + Chocolates</h2>
      <p class="text-gray-600">Presente perfeito para surpreender sua mãe 💝</p>
      <p class="text-2xl text-green-600 font-bold mt-2">R$ 25,00</p><button onclick="adicionarCarrinho()" class="mt-4 w-full bg-red-500 text-white py-3 rounded-xl hover:bg-red-600">
    Adicionar ao Carrinho 🛒
  </button>
</div>

  </section>  <!-- Carrinho -->  <section id="carrinho" class="hidden p-6">
    <div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow">
      <h3 class="text-xl font-bold mb-4">Seu Carrinho</h3>
      <p id="itemCarrinho">Cesta Dia das Mães - R$ 25,00</p>
      <button onclick="mostrarFormulario()" class="w-full mt-4 bg-green-500 text-white p-3 rounded-xl hover:bg-green-600">
        Finalizar Compra
      </button>
    </div>
  </section>  <!-- Formulário -->  <section id="formulario" class="hidden p-6">
    <div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow">
      <h3 class="text-xl font-bold mb-4">Criar Conta</h3><input id="nome" type="text" placeholder="Nome" class="w-full mb-3 p-2 border rounded">
  <input id="email" type="email" placeholder="Email" class="w-full mb-3 p-2 border rounded">
  <input id="endereco" type="text" placeholder="Endereço" class="w-full mb-3 p-2 border rounded">
  <input id="senha" type="password" placeholder="Senha" class="w-full mb-3 p-2 border rounded">

  <button onclick="salvarDados()" class="w-full bg-blue-500 text-white p-3 rounded-xl mt-2 hover:bg-blue-600">
    Salvar e Continuar
  </button>
</div>

  </section>  <!-- Pagamento -->  <section id="pagamento" class="hidden p-6">
    <div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow text-center">
      <h3 class="text-xl font-bold mb-4">Confirmar Compra</h3>
      <p id="resumo"></p><button onclick="pagar()" class="w-full mt-4 bg-green-500 text-white p-3 rounded-xl hover:bg-green-600">
    Ir para pagamento 💳
  </button>
</div>

  </section>  <!-- Footer -->  <footer class="text-center p-4 text-gray-600">
    © 2026 DIA DAS MÃES - Feito com carinho 💖
  </footer>  <script>
    function adicionarCarrinho() {
      document.getElementById('carrinho').classList.remove('hidden');
      window.scrollTo({ top: document.getElementById('carrinho').offsetTop, behavior: 'smooth' });
    }

    function mostrarFormulario() {
      document.getElementById('formulario').classList.remove('hidden');
      window.scrollTo({ top: document.getElementById('formulario').offsetTop, behavior: 'smooth' });
    }

    function salvarDados() {
      const nome = document.getElementById('nome').value;
      const email = document.getElementById('email').value;
      const endereco = document.getElementById('endereco').value;

      if (!nome || !email || !endereco) {
        alert('Preencha todos os campos!');
        return;
      }

      localStorage.setItem('cliente', JSON.stringify({ nome, email, endereco }));

      document.getElementById('resumo').innerText = `Nome: ${nome}\nEmail: ${email}\nEndereço: ${endereco}`;

      document.getElementById('pagamento').classList.remove('hidden');
      window.scrollTo({ top: document.getElementById('pagamento').offsetTop, behavior: 'smooth' });
    }

    function pagar() {
      window.location.href = "https://app.syncpayments.com.br/payment-link/a1a58857-4496-427c-9c7a-7e2f6bca4acd";
    }
  </script>

</body>
</html>
